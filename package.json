{
  "name": "senko-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/predev.mjs",
    "dev": "concurrently --names next,api --prefix-colors blue,yellow \"next dev --webpack\" \"node search-api/server.js\"",
    "predev:next": "node scripts/predev.mjs",
    "dev:next": "next dev --webpack",
    "dev:api": "node search-api/server.js",
    "build": "next build --webpack",
    "start": "next start",
    "deploy": "wasmer app deploy --dir . --owner senko-sleep --app-name senko-ai --build-remote --non-interactive",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "profile:browser": "node scripts/profile-browser.mjs",
    "test:e2e": "vitest run --config vitest.live.config.ts",
    "ollama-bridge": "node scripts/ollama-bridge.mjs",
    "voice:setup": "node scripts/voice-setup.mjs",
    "voice:serve": "node scripts/voice-service.mjs",
    "voice:test": "node --test scripts/voice-service.test.mjs",
    "dev:voice": "concurrently --names app,voice \"npm run dev\" \"npm run voice:serve\"",
    "voice:bank:test": "node --test scripts/senko-voice.test.mjs",
    "voice:bank:evaluate": "node scripts/senko-voice-evaluate.mjs",
    "voice:bank:build": "node scripts/senko-voice-build.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@echogarden/espeak-ng-emscripten": "^0.3.5",
    "@electric-sql/pglite": "0.5.8",
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4",
    "@novnc/novnc": "1.7.0",
    "@types/js-yaml": "^4.0.9",
    "@types/leaflet": "^1.9.21",
    "@vercel/sandbox": "^3.9.0",
    "@webcontainer/api": "1.6.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "compromise": "^14.14.5",
    "fflate": "0.8.3",
    "ffmpeg-static": "^5.3.0",
    "hls.js": "^1.6.15",
    "jiti": "^2.7.0",
    "js-yaml": "^4.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "pg": "8.23.1",
    "playwright": "1.63.0",
    "qrcode": "1.5.4",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^9.2.1",
    "esbuild": "0.25.12",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "raw-loader": "^4.0.2",
    "shadcn": "^3.8.4",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "vitest": "^4.0.18"
  }
}
