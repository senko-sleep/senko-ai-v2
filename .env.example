# Copy to .env.local for local use, or configure secrets on your deployment host.

# --- AI providers ------------------------------------------------------------
# "auto" tries: Ollama -> Groq -> OpenRouter -> DeepSeek -> OpenAI-compatible.
# Or name one to always try it first: ollama | groq | openrouter | deepseek | llm7 | sambanova | cloudflare | openai
LLM_PROVIDER=auto

# Your own model API (the senko-llm repo): a local model behind API keys, a queue and
# rate limits. Tried first when set; the cloud providers below are only a fallback.
# SENKO_LLM_URL=http://127.0.0.1:8787
# SENKO_LLM_KEY=
# SENKO_LLM_MODEL=                     # optional; the gateway's default model otherwise

# Local model, free and with no usage caps. Install from https://ollama.com, then:
#   ollama pull qwen3:4b-instruct      (needs ~3.5 GB free RAM; qwen3:1.7b needs ~2 GB)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct
# OLLAMA_NUM_CTX=8192                  # context window; lower it (4096) if RAM is tight
# OLLAMA_MAX_OUTPUT=1024
# OLLAMA_KEEP_ALIVE=2h                 # keep the model loaded between messages

# Every request is trimmed to fit each provider's budget (in tokens), so long chats
# don't get rejected. Defaults suit the free tiers; raise them on paid plans.
# GROQ_TOKEN_BUDGET=5000
# OPENROUTER_TOKEN_BUDGET=16000
# GEMINI_TOKEN_BUDGET=60000

# Free cloud tier (rate-limited per minute): https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b      # optional; picks a current model automatically

# Optional extra providers
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=                    # optional; defaults to a free model
DEEPSEEK_API_KEY=
# OpenAI-compatible gateway. Default model is "default".
LLM7_API_KEY=
# LLM7_MODEL=default
SAMBANOVA_API_KEY=
# SAMBANOVA_MODEL=                    # optional; automatically discovers available models
# SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1 # optional; dedicated endpoints can override this
# Cloudflare Workers AI requires both the account ID and an API token with Workers AI access.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct
# CLOUDFLARE_VISION_MODEL=            # optional; set to a vision-capable Workers AI model
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible API
# OPENAI_MODEL=gpt-4o-mini

# --- Hosting -------------------------------------------------------------------
# When set, the site asks for this password (any username). Always set it when hosted.
APP_PASSWORD=

# --- Agent ---------------------------------------------------------------------
# BROWSERBASE_API_KEY=                  # optional cloud Chromium for Agent mode
# BROWSERBASE_SESSION_TIMEOUT_SECONDS=3600 # Browserbase session lifetime, 60–21600 seconds
# BROWSERLESS_TOKEN=                     # first fallback; connects over Browserless CDP
# BROWSERLESS_CDP_ENDPOINT=wss://production-sfo.browserless.io
# BROWSERLESS_TIMEOUT_MS=3600000
# STEEL_API_KEY=                         # final managed-browser fallback
# STEEL_SESSION_TIMEOUT_MS=900000        # Steel hard session limit in milliseconds
# AGENT_MAX_STEPS=20
# BROWSER_PATH=                        # optional path to a Chrome/Chromium binary
# LIVE_FPS=120                         # ceiling (1-240); defaults to 30 on low-memory hosts, otherwise 120; viewer display rate also applies
# LIVE_QUALITY=60                      # JPEG quality of live frames (20-95)

# --- Rate limits (every AI request is paced to stay under these) ----------------
# Built-in defaults match each free tier; Groq/OpenRouter also report their real limits
# in response headers, which are learned automatically. Override per provider:
# LLM_LIMITS_GEMINI=rpm=15,tpm=250000,concurrency=3
# LLM_LIMITS_GROQ=rpm=30,tpm=8000,concurrency=2
# LLM_LIMITS_OPENROUTER=rpm=20,rpd=1000,concurrency=2
# LLM_LIMITS_DEEPSEEK=concurrency=4
# LLM_BACKGROUND_SHARE=0.85            # share of each limit agent/background work may use (rest kept for chat)
# AGENT_QUOTA_WAIT_MS=600000           # longest rate-limit wait the agent sits through before pausing
# AGENT_QUOTA_WAIT_TOTAL_MS=1200000    # most total waiting per task before it pauses (Resume continues)
