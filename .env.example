# Copy to .env.local for local use, or set these on your host (Render/Railway).

# --- AI providers ------------------------------------------------------------
# "auto" tries: Ollama -> Groq -> OpenRouter -> DeepSeek -> OpenAI-compatible.
# Or name one to always try it first: ollama | groq | openrouter | deepseek | openai
LLM_PROVIDER=auto

# Your own model API (the senko-llm repo): a local model behind API keys, a queue and
# rate limits. Tried first when set; the cloud providers below are only a fallback.
# SENKO_LLM_URL=http://127.0.0.1:8787
# SENKO_LLM_KEY=
# SENKO_LLM_MODEL=                     # optional; the gateway's default model otherwise

# Local model, free and with no usage caps. Install from https://ollama.com, then:
#   ollama pull qwen3:4b-instruct      (needs ~3.5 GB free RAM; qwen3:1.7b needs ~2 GB)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct
# OLLAMA_NUM_CTX=8192                  # context window; lower it (4096) if RAM is tight
# OLLAMA_MAX_OUTPUT=1024
# OLLAMA_KEEP_ALIVE=2h                 # keep the model loaded between messages

# Every request is trimmed to fit each provider's budget (in tokens), so long chats
# don't get rejected. Defaults suit the free tiers; raise them on paid plans.
# GROQ_TOKEN_BUDGET=5000
# OPENROUTER_TOKEN_BUDGET=16000
# GEMINI_TOKEN_BUDGET=60000

# Free cloud tier (rate-limited per minute): https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b      # optional; picks a current model automatically

# Optional extra providers
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=                    # optional; defaults to a free model
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible API
# OPENAI_MODEL=gpt-4o-mini

# --- Hosting -------------------------------------------------------------------
# When set, the site asks for this password (any username). Always set it when hosted.
APP_PASSWORD=

# --- Agent ---------------------------------------------------------------------
# AGENT_MAX_STEPS=20
# BROWSER_PATH=                        # optional path to a Chrome/Chromium binary
# LIVE_FPS=30                          # live browser view frame rate (up to 60)
# LIVE_QUALITY=60                      # JPEG quality of live frames (20-95)
